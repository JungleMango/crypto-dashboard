//@version=6
indicator('Clean Trade Signals [Win-Lock & Auto-BE Engine]', overlay = true, max_bars_back = 500, max_lines_count = 500, max_labels_count = 500)

// ═════════════════════════════════════════════════════════════════
// SETTINGS
// ═════════════════════════════════════════════════════════════════
sensitivity = input.float(1.0, 'Sensitivity (Lower = More Signals)', step = 0.1, minval = 0.1)
atr_period  = input.int(10,    'ATR Period', minval = 1)
show_trail  = input.bool(true, 'Show Trailing Trend Line')
show_stats  = input.bool(true, 'Show Win Rate Table', group = 'Stats Table')
stats_pos   = input.string('Top Right', 'Table Position', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left'], group = 'Stats Table')
strict_eval = input.bool(true, 'Conservative Scoring (TP1 + SL on same bar = Loss)', group = 'Stats Table')

// Filters
use_ema   = input.bool(true,  'EMA Trend Filter',   group = 'Filters')
ema_len   = input.int(200,    'EMA Length',         minval = 1, group = 'Filters')
show_ema  = input.bool(true,  'Show EMA',           group = 'Filters')
use_adx   = input.bool(true,  'ADX Chop Filter',    group = 'Filters')
adx_len   = input.int(14,     'ADX Length',         minval = 1, group = 'Filters')
adx_min   = input.float(20,   'Min ADX',            step = 1, group = 'Filters')
use_htf   = input.bool(false, 'Higher TF Trend Filter', group = 'Filters')
htf       = input.timeframe('60', 'Higher Timeframe', group = 'Filters')
htf_len   = input.int(50,     'Higher TF EMA Length', minval = 1, group = 'Filters')
min_risk  = input.float(0.5,  'Min Risk (x ATR)',   step = 0.1, minval = 0, group = 'Filters')
sl_buffer = input.float(0.2,  'SL Buffer (x ATR)',  step = 0.1, minval = 0, group = 'Filters')

// Market Structure
show_sr       = input.bool(true,  'Show Support / Resistance',          group = 'Market Structure')
piv_len       = input.int(10,     'Pivot Strength (bars each side)',    minval = 2, group = 'Market Structure')
sr_count      = input.int(4,      'Max Levels per Side',                minval = 1, maxval = 20, group = 'Market Structure')
sr_del_broken = input.bool(false, 'Delete Broken Levels (else fade them)', group = 'Market Structure')
show_swings   = input.bool(true,  'Show Reversal Points (HH / HL / LH / LL)', group = 'Market Structure')
show_tl       = input.bool(true,  'Show Trendlines',                    group = 'Market Structure')
color_bars    = input.bool(false, 'Color Candles by Trend',             group = 'Market Structure')
show_bg       = input.bool(false, 'Trend Background',                   group = 'Market Structure')

// Higher Timeframe Levels
show_htf1   = input.bool(true,  'HTF 1 Levels',             inline = 'h1', group = 'Higher Timeframe Levels')
htf1        = input.timeframe('60',  '',                    inline = 'h1', group = 'Higher Timeframe Levels')
show_htf2   = input.bool(true,  'HTF 2 Levels',             inline = 'h2', group = 'Higher Timeframe Levels')
htf2        = input.timeframe('240', '',                    inline = 'h2', group = 'Higher Timeframe Levels')
htf_piv_len = input.int(5,      'HTF Pivot Strength',       minval = 2, group = 'Higher Timeframe Levels')
htf_count   = input.int(3,      'Max HTF Levels per Side',  minval = 1, maxval = 10, group = 'Higher Timeframe Levels')
show_pdhl   = input.bool(true,  'Previous Day High / Low',  group = 'Higher Timeframe Levels')
show_pwhl   = input.bool(true,  'Previous Week High / Low', group = 'Higher Timeframe Levels')

// Level Tags
show_tags  = input.bool(true, 'Show Level Tags',                     group = 'Level Tags')
tag_offset = input.int(3,     'Tag Position (bars right of last candle)', minval = -50, maxval = 50, group = 'Level Tags')
tag_size_s = input.string('Normal', 'Tag Size', options = ['Small', 'Normal', 'Large'], group = 'Level Tags')
tag_size   = tag_size_s == 'Small' ? size.small : tag_size_s == 'Large' ? size.large : size.normal

// Colors
c_bull = #00e676
c_bear = #ff1744

// ═════════════════════════════════════════════════════════════════
// CORE UT TRAILING STOP
// ═════════════════════════════════════════════════════════════════
xATR  = ta.atr(atr_period)
nLoss = sensitivity * xATR

var float trailing_stop = na
if na(trailing_stop)
    trailing_stop := close - nLoss
else
    if close > trailing_stop[1] and close[1] > trailing_stop[1]
        trailing_stop := math.max(trailing_stop[1], close - nLoss)
    else if close < trailing_stop[1] and close[1] < trailing_stop[1]
        trailing_stop := math.min(trailing_stop[1], close + nLoss)
    else if close > trailing_stop[1]
        trailing_stop := close - nLoss
    else
        trailing_stop := close + nLoss

raw_long  = ta.crossover(close, trailing_stop)
raw_short = ta.crossunder(close, trailing_stop)

// Structural Pivots
pivot_high = ta.highest(high, 10)[1]
pivot_low  = ta.lowest(low, 10)[1]

// ═════════════════════════════════════════════════════════════════
// SIGNAL FILTERS
// ═════════════════════════════════════════════════════════════════
ema_val         = ta.ema(close, ema_len)
[_, _, adx_val] = ta.dmi(adx_len, adx_len)
htf_ema         = request.security(syminfo.tickerid, htf, ta.ema(close, htf_len)[1], lookahead = barmerge.lookahead_on)

// Stop levels with ATR buffer beyond the structure
long_sl_est  = math.min(pivot_low,  trailing_stop) - sl_buffer * xATR
short_sl_est = math.max(pivot_high, trailing_stop) + sl_buffer * xATR

long_ok  = (not use_ema or close > ema_val) and (not use_adx or adx_val > adx_min) and (not use_htf or close > htf_ema) and (close - long_sl_est)  >= min_risk * xATR
short_ok = (not use_ema or close < ema_val) and (not use_adx or adx_val > adx_min) and (not use_htf or close < htf_ema) and (short_sl_est - close) >= min_risk * xATR

// ═════════════════════════════════════════════════════════════════
// MARKET STRUCTURE: REVERSAL POINTS, S/R LEVELS & TRENDLINES
// ═════════════════════════════════════════════════════════════════
c_res  = color.new(c_bear, 30)
c_sup  = color.new(c_bull, 30)
c_none = color.new(color.white, 100)

ph = ta.pivothigh(high, piv_len, piv_len)
pl = ta.pivotlow(low, piv_len, piv_len)

var float  last_ph     = na
var float  prev_ph     = na
var int    last_ph_bar = na
var int    prev_ph_bar = na
var float  last_pl     = na
var float  prev_pl     = na
var int    last_pl_bar = na
var int    prev_pl_bar = na
var string last_h_type = '—'
var string last_l_type = '—'

// A horizontal level: the line plus its name tag (tag sits ABOVE the line)
type Level
    line  ln
    label lb

f_new_tag(float price, string txt, color col) =>
    show_tags ? label.new(bar_index + tag_offset, price, txt, color = c_none, textcolor = col,
                          style = label.style_label_down, size = tag_size) : na

f_add_level(array<Level> arr, int t, float price, color col, int w, string st, string txt, int max_n) =>
    array.push(arr, Level.new(line.new(t, price, time, price, xloc = xloc.bar_time, extend = extend.right, color = col, style = st, width = w),
                              f_new_tag(price, txt, col)))
    if array.size(arr) > max_n
        Level old = array.shift(arr)
        line.delete(old.ln)
        label.delete(old.lb)

// A level is broken once price closes through it
f_check_broken(array<Level> arr, bool is_res) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            Level lv  = array.get(arr, i)
            float lvl = line.get_y1(lv.ln)
            if is_res ? close > lvl : close < lvl
                label.delete(lv.lb)
                if sr_del_broken
                    line.delete(lv.ln)
                else
                    line.set_extend(lv.ln, extend.none)
                    line.set_x2(lv.ln, time)
                    line.set_style(lv.ln, line.style_dotted)
                    line.set_color(lv.ln, color.new(color.gray, 50))
                array.remove(arr, i)

// Keep tags pinned next to the latest candle so they stay on screen
f_move_tags(array<Level> arr) =>
    for lv in arr
        label.set_x(lv.lb, bar_index + tag_offset)

f_tf_name(string tf) =>
    int m = int(timeframe.in_seconds(tf) / 60)
    m >= 1440 ? tf : m % 60 == 0 ? str.tostring(m / 60, '#') + 'H' : str.tostring(m) + 'm'

chart_tf_name = f_tf_name(timeframe.period)

var array<Level> res_lines = array.new<Level>()
var array<Level> sup_lines = array.new<Level>()
var line tl_res = na
var line tl_sup = na

// New swing high confirmed
if not na(ph)
    prev_ph     := last_ph
    prev_ph_bar := last_ph_bar
    last_ph     := ph
    last_ph_bar := bar_index - piv_len
    last_h_type := na(prev_ph) ? 'H' : ph > prev_ph ? 'HH' : 'LH'

    if show_swings
        label.new(last_ph_bar, ph, last_h_type, color = c_none, textcolor = last_h_type == 'HH' ? c_bull : c_bear,
                  style = label.style_label_down, size = size.small)
    if show_sr
        f_add_level(res_lines, time[piv_len], ph, c_res, 1, line.style_dashed, chart_tf_name + ' R', sr_count)
    if show_tl
        // Lower high -> descending resistance trendline; higher high invalidates it
        line.delete(tl_res)
        tl_res := last_h_type == 'LH' ? line.new(prev_ph_bar, prev_ph, last_ph_bar, ph, extend = extend.right, color = c_bear, width = 2) : na

// New swing low confirmed
if not na(pl)
    prev_pl     := last_pl
    prev_pl_bar := last_pl_bar
    last_pl     := pl
    last_pl_bar := bar_index - piv_len
    last_l_type := na(prev_pl) ? 'L' : pl > prev_pl ? 'HL' : 'LL'

    if show_swings
        label.new(last_pl_bar, pl, last_l_type, color = c_none, textcolor = last_l_type == 'HL' ? c_bull : c_bear,
                  style = label.style_label_up, size = size.small)
    if show_sr
        f_add_level(sup_lines, time[piv_len], pl, c_sup, 1, line.style_dashed, chart_tf_name + ' S', sr_count)
    if show_tl
        // Higher low -> ascending support trendline; lower low invalidates it
        line.delete(tl_sup)
        tl_sup := last_l_type == 'HL' ? line.new(prev_pl_bar, prev_pl, last_pl_bar, pl, extend = extend.right, color = c_bull, width = 2) : na

f_check_broken(res_lines, true)
f_check_broken(sup_lines, false)

// ═════════════════════════════════════════════════════════════════
// HIGHER TIMEFRAME LEVELS (NON-REPAINTING: ONLY CONFIRMED HTF BARS)
// ═════════════════════════════════════════════════════════════════
c_day  = #2962ff
c_week = #e040fb

// Runs on the higher timeframe: latest confirmed pivot high/low and the time of its bar
f_htf_piv(int len) =>
    float hp = ta.pivothigh(high, len, len)
    float lp = ta.pivotlow(low, len, len)
    [ta.valuewhen(not na(hp), hp, 0)[1], ta.valuewhen(not na(hp), time[len], 0)[1],
     ta.valuewhen(not na(lp), lp, 0)[1], ta.valuewhen(not na(lp), time[len], 0)[1]]

[h1_ph, h1_ph_t, h1_pl, h1_pl_t] = request.security(syminfo.tickerid, htf1, f_htf_piv(htf_piv_len), lookahead = barmerge.lookahead_on)
[h2_ph, h2_ph_t, h2_pl, h2_pl_t] = request.security(syminfo.tickerid, htf2, f_htf_piv(htf_piv_len), lookahead = barmerge.lookahead_on)
[pdh, pdl] = request.security(syminfo.tickerid, 'D', [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, 'W', [high[1], low[1]], lookahead = barmerge.lookahead_on)

var array<Level> h1_res = array.new<Level>()
var array<Level> h1_sup = array.new<Level>()
var array<Level> h2_res = array.new<Level>()
var array<Level> h2_sup = array.new<Level>()

f_key_level(Level old, int t0, float price, color col, string txt) =>
    if not na(old)
        line.delete(old.ln)
        label.delete(old.lb)
    Level.new(line.new(t0, price, time, price, xloc = xloc.bar_time, extend = extend.right, color = col, style = line.style_dotted, width = 2),
              f_new_tag(price, txt, col))

// Only draw timeframes that are actually higher than the chart
htf1_on = show_htf1 and timeframe.in_seconds(htf1) > timeframe.in_seconds()
htf2_on = show_htf2 and timeframe.in_seconds(htf2) > timeframe.in_seconds()

if htf1_on and not na(h1_ph) and (na(h1_ph_t[1]) or h1_ph_t != h1_ph_t[1])
    f_add_level(h1_res, h1_ph_t, h1_ph, c_bear, 2, line.style_solid, f_tf_name(htf1) + ' R', htf_count)
if htf1_on and not na(h1_pl) and (na(h1_pl_t[1]) or h1_pl_t != h1_pl_t[1])
    f_add_level(h1_sup, h1_pl_t, h1_pl, c_bull, 2, line.style_solid, f_tf_name(htf1) + ' S', htf_count)
if htf2_on and not na(h2_ph) and (na(h2_ph_t[1]) or h2_ph_t != h2_ph_t[1])
    f_add_level(h2_res, h2_ph_t, h2_ph, c_bear, 3, line.style_solid, f_tf_name(htf2) + ' R', htf_count)
if htf2_on and not na(h2_pl) and (na(h2_pl_t[1]) or h2_pl_t != h2_pl_t[1])
    f_add_level(h2_sup, h2_pl_t, h2_pl, c_bull, 3, line.style_solid, f_tf_name(htf2) + ' S', htf_count)

f_check_broken(h1_res, true)
f_check_broken(h1_sup, false)
f_check_broken(h2_res, true)
f_check_broken(h2_sup, false)

var Level pdh_lv = na
var Level pdl_lv = na
var Level pwh_lv = na
var Level pwl_lv = na

if barstate.islast
    if show_pdhl
        pdh_lv := f_key_level(pdh_lv, time('D'), pdh, c_day, 'PDH')
        pdl_lv := f_key_level(pdl_lv, time('D'), pdl, c_day, 'PDL')
    if show_pwhl
        pwh_lv := f_key_level(pwh_lv, time('W'), pwh, c_week, 'PWH')
        pwl_lv := f_key_level(pwl_lv, time('W'), pwl, c_week, 'PWL')
    f_move_tags(res_lines)
    f_move_tags(sup_lines)
    f_move_tags(h1_res)
    f_move_tags(h1_sup)
    f_move_tags(h2_res)
    f_move_tags(h2_sup)

// Trend state: 1 = Bullish, -1 = Bearish, 0 = Ranging / Mixed
int trend_state = adx_val < adx_min ? 0 : close > trailing_stop and close > ema_val ? 1 : close < trailing_stop and close < ema_val ? -1 : 0
int ms_trend    = last_h_type == 'HH' and last_l_type == 'HL' ? 1 : last_h_type == 'LH' and last_l_type == 'LL' ? -1 : 0

// ═════════════════════════════════════════════════════════════════
// TRADE TRACKER WITH IMMUTABLE WIN-LOCK
// ═════════════════════════════════════════════════════════════════
var label active_lbl   = na
var int   t_dir        = 0      // 1: Long, -1: Short, 0: Idle
var int   t_start_bar  = 0
var float t_entry      = na
var float t_tp1        = na
var float t_tp2        = na
var float t_tp3        = na
var float t_sl         = na
var bool  hit_tp1      = false
var bool  hit_tp2      = false
var bool  hit_tp3      = false
var bool  hit_sl       = false
var bool  be_locked    = false

// Win/Loss Statistics (Win = TP1 touched, Loss = SL hit before TP1)
var int long_wins    = 0
var int long_losses  = 0
var int short_wins   = 0
var int short_losses = 0

// Formatter for Card
f_render_text(is_long, entry, tp1, tp2, tp3, sl, h1, h2, h3, hsl, is_be) =>
    string header = is_long ? '🟢 LONG' : '🔴 SHORT'
    string s_tp1  = 'TP1: ' + str.tostring(tp1, '#.#####') + (h1 ? ' ✅' : '')
    string s_tp2  = 'TP2: ' + str.tostring(tp2, '#.#####') + (h2 ? ' ✅' : '')
    string s_tp3  = 'TP3: ' + str.tostring(tp3, '#.#####') + (h3 ? ' ✅' : '')
    string s_sl   = ''
    if hsl
        s_sl := 'SL: ' + str.tostring(sl, '#.#####') + ' ❌'
    else if is_be
        s_sl := 'SL: BREAKEVEN 🛡️'
    else
        s_sl := 'SL: ' + str.tostring(sl, '#.#####')

    header + '\n' +
      'ENTRY: ' + str.tostring(entry, '#.#####') + '\n' +
      s_tp1 + '\n' +
      s_tp2 + '\n' +
      s_tp3 + '\n' +
      s_sl

// Check Active Trade Progress
if t_dir == 1
    // Long Evaluation
    // Ambiguous bar: TP1 and SL both touched, order unknown -> score as loss
    if strict_eval and not hit_tp1 and high >= t_tp1 and low <= t_sl
        hit_sl      := true
        t_dir       := 0
        long_losses += 1

    if not hit_tp1 and not hit_sl and high >= t_tp1
        hit_tp1   := true
        be_locked := true  // Auto-Breakeven engaged!
        t_sl      := t_entry
        long_wins += 1     // Win is locked the moment TP1 is touched

    if not hit_tp2 and not hit_sl and high >= t_tp2
        hit_tp2 := true

    if not hit_tp3 and not hit_sl and high >= t_tp3
        hit_tp3 := true

    // Only allow SL trigger if TP1 was NEVER touched and not on entry bar
    if not hit_tp1 and not hit_sl and bar_index > t_start_bar and low <= t_sl
        hit_sl      := true
        t_dir       := 0  // Trade closed on SL
        long_losses += 1

    // If trade reached any TP, a later retracement closes trade safely at BE (no red X)
    if hit_tp1 and low <= t_entry
        t_dir := 0

    // Full target completed
    if hit_tp3
        t_dir := 0

    label.set_text(active_lbl, f_render_text(true, t_entry, t_tp1, t_tp2, t_tp3, t_sl, hit_tp1, hit_tp2, hit_tp3, hit_sl, be_locked))

if t_dir == -1
    // Short Evaluation
    // Ambiguous bar: TP1 and SL both touched, order unknown -> score as loss
    if strict_eval and not hit_tp1 and low <= t_tp1 and high >= t_sl
        hit_sl       := true
        t_dir        := 0
        short_losses += 1

    if not hit_tp1 and not hit_sl and low <= t_tp1
        hit_tp1    := true
        be_locked  := true  // Auto-Breakeven engaged!
        t_sl       := t_entry
        short_wins += 1     // Win is locked the moment TP1 is touched

    if not hit_tp2 and not hit_sl and low <= t_tp2
        hit_tp2 := true

    if not hit_tp3 and not hit_sl and low <= t_tp3
        hit_tp3 := true

    // Only allow SL trigger if TP1 was NEVER touched and not on entry bar
    if not hit_tp1 and not hit_sl and bar_index > t_start_bar and high >= t_sl
        hit_sl       := true
        t_dir        := 0  // Trade closed on SL
        short_losses += 1

    // If trade reached any TP, a later retracement closes trade safely at BE (no red X)
    if hit_tp1 and high >= t_entry
        t_dir := 0

    // Full target completed
    if hit_tp3
        t_dir := 0

    label.set_text(active_lbl, f_render_text(false, t_entry, t_tp1, t_tp2, t_tp3, t_sl, hit_tp1, hit_tp2, hit_tp3, hit_sl, be_locked))

// ═════════════════════════════════════════════════════════════════
// ENTRY GATES (NO NEW TRADES UNTIL CURRENT RESOLVES)
// ═════════════════════════════════════════════════════════════════
can_enter = (t_dir == 0)

valid_long  = raw_long  and can_enter and long_ok
valid_short = raw_short and can_enter and short_ok

if valid_long
    t_dir       := 1
    t_start_bar := bar_index
    t_entry     := close
    t_sl        := long_sl_est
    float risk  = t_entry - t_sl
    t_tp1       := t_entry + (risk * 0.50)  // Rapid scalp win target
    t_tp2       := math.max(t_entry + risk, pivot_high)
    t_tp3       := t_entry + (risk * 2.0)
    hit_tp1     := false
    hit_tp2     := false
    hit_tp3     := false
    hit_sl      := false
    be_locked   := false

    string init_msg = f_render_text(true, t_entry, t_tp1, t_tp2, t_tp3, t_sl, false, false, false, false, false)
    active_lbl := label.new(bar_index, low, text = init_msg, color = #0d2e1f, textcolor = c_bull,
                            style = label.style_label_up, size = size.normal, textalign = text.align_left)

if valid_short
    t_dir       := -1
    t_start_bar := bar_index
    t_entry     := close
    t_sl        := short_sl_est
    float risk  = t_sl - t_entry
    t_tp1       := t_entry - (risk * 0.50)  // Rapid scalp win target
    t_tp2       := math.min(t_entry - risk, pivot_low)
    t_tp3       := t_entry - (risk * 2.0)
    hit_tp1     := false
    hit_tp2     := false
    hit_tp3     := false
    hit_sl      := false
    be_locked   := false

    string init_msg = f_render_text(false, t_entry, t_tp1, t_tp2, t_tp3, t_sl, false, false, false, false, false)
    active_lbl := label.new(bar_index, high, text = init_msg, color = #380d16, textcolor = c_bear,
                            style = label.style_label_down, size = size.normal, textalign = text.align_left)

// ═════════════════════════════════════════════════════════════════
// WIN RATE TABLE
// ═════════════════════════════════════════════════════════════════
f_table_pos(p) =>
    switch p
        'Top Left'     => position.top_left
        'Bottom Right' => position.bottom_right
        'Bottom Left'  => position.bottom_left
        => position.top_right

f_rate_str(wins, losses) =>
    int total = wins + losses
    total > 0 ? str.tostring(wins * 100.0 / total, '#.0') + '%' : '—'

f_rate_color(wins, losses) =>
    int total = wins + losses
    total == 0 ? color.gray : (wins * 100.0 / total >= 50 ? c_bull : c_bear)

f_row(tbl, row, name, name_col, wins, losses) =>
    color txt = color.white
    table.cell(tbl, 0, row, name,                              text_color = name_col, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, row, str.tostring(wins + losses),       text_color = txt,      text_size = size.small)
    table.cell(tbl, 2, row, str.tostring(wins),                text_color = c_bull,   text_size = size.small)
    table.cell(tbl, 3, row, str.tostring(losses),              text_color = c_bear,   text_size = size.small)
    table.cell(tbl, 4, row, f_rate_str(wins, losses),          text_color = f_rate_color(wins, losses), text_size = size.small)

var table stats_tbl = table.new(f_table_pos(stats_pos), 5, 6, bgcolor = #131722, border_color = #2a2e39, border_width = 1, frame_color = #2a2e39, frame_width = 1)

if show_stats and barstate.islast
    color hdr = #787b86
    table.cell(stats_tbl, 0, 0, 'Side',     text_color = hdr, text_size = size.small, text_halign = text.align_left)
    table.cell(stats_tbl, 1, 0, 'Trades',   text_color = hdr, text_size = size.small)
    table.cell(stats_tbl, 2, 0, 'Wins',     text_color = hdr, text_size = size.small)
    table.cell(stats_tbl, 3, 0, 'Losses',   text_color = hdr, text_size = size.small)
    table.cell(stats_tbl, 4, 0, 'Win Rate', text_color = hdr, text_size = size.small)

    f_row(stats_tbl, 1, '🟢 Long',  c_bull,      long_wins,                long_losses)
    f_row(stats_tbl, 2, '🔴 Short', c_bear,      short_wins,               short_losses)
    f_row(stats_tbl, 3, 'Total',    color.white, long_wins + short_wins,   long_losses + short_losses)

    string trend_txt = trend_state == 1 ? '▲ Bullish' : trend_state == -1 ? '▼ Bearish' : '◆ Ranging'
    color  trend_col = trend_state == 1 ? c_bull : trend_state == -1 ? c_bear : color.gray
    string ms_txt    = (ms_trend == 1 ? '▲ Uptrend' : ms_trend == -1 ? '▼ Downtrend' : '◆ Mixed') + '  (' + last_h_type + ' / ' + last_l_type + ')'
    color  ms_col    = ms_trend == 1 ? c_bull : ms_trend == -1 ? c_bear : color.gray
    table.cell(stats_tbl, 0, 4, 'Trend',     text_color = hdr, text_size = size.small, text_halign = text.align_left)
    table.cell(stats_tbl, 1, 4, trend_txt + '  (ADX ' + str.tostring(adx_val, '#') + ')', text_color = trend_col, text_size = size.small, text_halign = text.align_left)
    table.cell(stats_tbl, 0, 5, 'Structure', text_color = hdr, text_size = size.small, text_halign = text.align_left)
    table.cell(stats_tbl, 1, 5, ms_txt,      text_color = ms_col,    text_size = size.small, text_halign = text.align_left)

if barstate.isfirst
    table.merge_cells(stats_tbl, 1, 4, 4, 4)
    table.merge_cells(stats_tbl, 1, 5, 4, 5)

// ═════════════════════════════════════════════════════════════════
// PLOTS & ALERTS
// ═════════════════════════════════════════════════════════════════
plot(show_trail ? trailing_stop : na, 'Trend Line', 
     color = close > trailing_stop ? c_bull : c_bear, 
     linewidth = 2, 
     style = plot.style_linebr)

plot(use_ema and show_ema ? ema_val : na, 'Trend EMA', color = color.new(#ffb300, 0), linewidth = 1)

color trend_color = trend_state == 1 ? c_bull : trend_state == -1 ? c_bear : color.gray
barcolor(color_bars ? trend_color : na)
bgcolor(show_bg ? color.new(trend_color, 92) : na)

alertcondition(valid_long,  title = 'Long Entry',  message = 'LONG {{ticker}} @ {{close}}')
alertcondition(valid_short, title = 'Short Entry', message = 'SHORT {{ticker}} @ {{close}}')
alertcondition(not na(ph) and last_h_type == 'LH', title = 'Lower High (Bearish Reversal Point)', message = 'Lower High on {{ticker}}')
alertcondition(not na(pl) and last_l_type == 'HL', title = 'Higher Low (Bullish Reversal Point)', message = 'Higher Low on {{ticker}}')
